{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swap-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  // Secret NAMES only (values set via `wrangler secret put <NAME>`, never committed).
  // `secrets.required` drives typed bindings and fail-closed validation on deploy.
  "secrets": {
    "required": [
      "SWAP_PRIVATE_KEY",
      "AUTH_PASSPHRASE",
      "UNISWAP_API_KEY",
      "ETH_RPC_URL",
    ],
  },
  "vars": {
    "CHAIN_ID": "1",
    "CANONICAL_MCP_URI": "https://swap-mcp.simon-tanna.workers.dev",
    "TRADING_API_BASE_URL": "https://trade-api.gateway.uniswap.org/v1",
    "ALLOWED_ORIGINS": "https://claude.ai,https://swap-mcp.simon-tanna.workers.dev",
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "a6ab87229be3401daa52522f8b1c902c",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swap-mcp",
      "database_id": "709b442a-7837-401e-98f3-eba6c055874d",
      "migrations_dir": "drizzle",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SWAP_COORDINATOR",
        "class_name": "SwapCoordinator",
      },
      // The binding NAME must equal the class name (`SwapMcpAgent`, NOT
      // SCREAMING_SNAKE): `McpAgent.serve()` looks the DO up by class name, so
      // renaming it for consistency with SWAP_COORDINATOR would break routing.
      {
        "name": "SwapMcpAgent",
        "class_name": "SwapMcpAgent",
      },
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SwapCoordinator", "SwapMcpAgent", "RateLimiter"],
    },
  ],
  "observability": {
    // MUST be true: this top-level flag gates ALL Workers-Logs persistence.
    // The nested `logs.enabled` does NOT override it — with this false, the
    // structured diagnostic logs are visible only via `wrangler tail`, never in
    // the dashboard/query builder.
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
