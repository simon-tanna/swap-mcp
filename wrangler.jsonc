{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swap-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  // Secret NAMES only (values set via `wrangler secret put <NAME>`, never committed).
  // `secrets.required` drives typed bindings and fail-closed validation on deploy.
  "secrets": {
    "required": [
      "SWAP_PRIVATE_KEY",
      "AUTH_PASSPHRASE",
      "UNISWAP_API_KEY",
      "ETH_RPC_URL",
    ],
  },
  "vars": {
    "CHAIN_ID": "1",
    "CANONICAL_MCP_URI": "https://swap-mcp.example.workers.dev/mcp",
    "TRADING_API_BASE_URL": "https://trade-api.gateway.uniswap.org/v1",
    "ALLOWED_ORIGINS": "https://claude.ai,https://swap-mcp.example.workers.dev",
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "<placeholder-kv-id>",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swap-mcp",
      "database_id": "<placeholder-d1-id>",
      "migrations_dir": "drizzle",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SWAP_COORDINATOR",
        "class_name": "SwapCoordinator",
      },
      // The binding NAME must equal the class name (`SwapMcpAgent`, NOT
      // SCREAMING_SNAKE): `McpAgent.serve()` looks the DO up by class name, so
      // renaming it for consistency with SWAP_COORDINATOR would break routing.
      {
        "name": "SwapMcpAgent",
        "class_name": "SwapMcpAgent",
      },
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter",
      },
    ],
  },
  // A single `v1` tag whose `new_sqlite_classes` grows across later tasks; SQLite-backed
  // DOs are required for the eager D1 lifecycle writes (and for McpAgent session state).
  // NOTE: a real `wrangler deploy` needs a fresh tag (`v2`) to introduce SwapMcpAgent —
  // per T18's migrations-tag note, an already-applied tag must not gain classes. Growing
  // `v1` in place is boot-safe LOCALLY ONLY (no deploy mid-build); split to `v2` before deploy.
  // Likewise, RateLimiter needs its own fresh tag (`v3`) on a real deploy — do not add it to
  // an already-applied tag; growing `v1` in place stays boot-safe LOCALLY ONLY.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SwapCoordinator", "SwapMcpAgent", "RateLimiter"],
    },
  ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
